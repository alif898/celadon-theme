{
  "name": {{ config.name | tojson }},
  "base": "dark",
  "colors": {
    "primary": "#{{ theme.accent }}",
    "accent": "#{{ theme.accent_alt }}",
    "text": "#{{ theme.base4 }}",
    "textStrong": "#{{ theme.cream }}",
    "textDim": "#{{ theme.bone }}",
    "textMuted": "#{{ theme.bone_alt }}",
    "border": "#{{ theme.accent }}",
    "borderFocus": "#{{ theme.purple }}",
    "success": "#{{ theme.lime }}",
    "warning": "#{{ theme.pink }}",
    "error": "#{{ theme.orange }}",
    "diffAdded": "#{{ theme.lime_alt2 }}",
    "diffRemoved": "#{{ theme.red_alt2 }}",
    "diffAddedStrong": "#{{ theme.lime_alt }}",
    "diffRemovedStrong": "#{{ theme.red_alt }}",
    "diffGutter": "#{{ theme.base3 }}",
