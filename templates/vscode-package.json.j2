{
  "name": {{ config.plugin_name | tojson }},
  "displayName": {{ config.name | tojson }},
  "description": {{ config.short_description | tojson }},
  "version": {{ config.version | tojson }},
  "publisher": {{ config.vs_code_publisher | tojson }},
  "license": "SEE LICENSE IN LICENSE.md",
  "icon": "icon.png",
  "homepage": {{ config.github_url | tojson }},
  "repository": {
    "type": "git",
    "url": {{ config.direct_git_url | tojson }}
  },
  "qna": {{ config.issues_url | tojson }},
  "sponsor": {
    "url": {{ config.sponsor_url | tojson }}
  },
  "pricing": "Free",
  "galleryBanner": {
    "color": "{{ theme.base1 }}",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "dark",
    "minimal",
    "eye-friendly",
    "contrast",
    "muted",
    "matte",
    "celadon",
    "ceramic",
    "pastel",
    "jade",
    "green",
    "teal"
  ],
  "contributes": {
    "themes": [
      {
        "label": {{ config.name | tojson }},
        "uiTheme": "vs-dark",
        "path": "./themes/celadon-theme-color-theme.json"
      }
    ]
  }
}
