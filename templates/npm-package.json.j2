{
  "name": {{ config.plugin_name | tojson }},
  "version": {{ config.version | tojson }},
  "description": {{ (config.npm_description or config.short_description) | tojson }},
  "license": "MIT",
  "author": {{ config.author | tojson }},
  "homepage": {{ config.github_url | tojson }},
  "repository": {
    "type": "git",
    "url": {{ config.direct_git_url | tojson }}
