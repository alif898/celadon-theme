{#- OpenCode custom theme JSON. The theme name is derived from the file
   name, so no "name" key may appear here. OpenCode requires both fields
   inside a {"dark", "light"} variant object, and celadon is dark-only,
   so both fields carry the same value. Only 6-digit palette keys are
   used, matching the schema's #rrggbb colorValue contract. -#}
{%- macro color(key) %}{"dark": "#{{ theme[key] }}", "light": "#{{ theme[key] }}"}{% endmacro -%}
{
  "$schema": "https://opencode.ai/theme.json",
  "theme": {
    "primary": {{ color("accent") }},
    "secondary": {{ color("purple") }},
    "accent": {{ color("pink") }},
    "error": {{ color("orange") }},
    "warning": {{ color("pink") }},
    "success": {{ color("lime") }},
    "info": {{ color("cyan") }},
    "text": {{ color("base4") }},
    "textMuted": {{ color("bone_alt") }},
    "background": {{ color("base0") }},
    "backgroundPanel": {{ color("base1") }},
    "backgroundElement": {{ color("base2") }},
    "border": {{ color("accent") }},
    "borderActive": {{ color("purple") }},
    "borderSubtle": {{ color("base2") }},
    "diffAdded": {{ color("lime_alt") }},
    "diffRemoved": {{ color("red_alt") }},
    "diffContext": {{ color("base3") }},
    "diffHunkHeader": {{ color("base3") }},
    "diffHighlightAdded": {{ color("lime_alt") }},
    "diffHighlightRemoved": {{ color("red_alt") }},
    "diffAddedBg": {{ color("base1") }},
    "diffRemovedBg": {{ color("base1") }},
    "diffContextBg": {{ color("base1") }},
    "diffLineNumber": {{ color("base2") }},
    "diffAddedLineNumberBg": {{ color("base1") }},
    "diffRemovedLineNumberBg": {{ color("base1") }},
    "markdownText": {{ color("base4") }},
    "markdownHeading": {{ color("pink_alt") }},
    "markdownLink": {{ color("cyan") }},
    "markdownLinkText": {{ color("blue_alt") }},
    "markdownCode": {{ color("purple") }},
    "markdownBlockQuote": {{ color("base3") }},
    "markdownEmph": {{ color("purple_alt") }},
    "markdownStrong": {{ color("cyan") }},
    "markdownHorizontalRule": {{ color("base3") }},
    "markdownListItem": {{ color("purple") }},
    "markdownListEnumeration": {{ color("purple_alt") }},
    "markdownImage": {{ color("pink") }},
    "markdownImageText": {{ color("pink_alt") }},
    "markdownCodeBlock": {{ color("base4") }},
    "syntaxComment": {{ color("base3") }},
    "syntaxKeyword": {{ color("pink") }},
    "syntaxFunction": {{ color("green") }},
    "syntaxVariable": {{ color("base4") }},
    "syntaxString": {{ color("purple") }},
    "syntaxNumber": {{ color("orange") }},
    "syntaxType": {{ color("cyan") }},
    "syntaxOperator": {{ color("base4") }},
    "syntaxPunctuation": {{ color("base4") }}
  }
}
