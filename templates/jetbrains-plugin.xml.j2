<idea-plugin require-restart="false">
    <id>{{ config.id | e }}</id>
    <version>{{ config.version | e }}</version>
    <name>{{ config.name | e }}</name>
    <category>UI</category>
    <vendor url="{{ config.vendor_url | e }}">{{ config.author | e }}</vendor>
    <idea-version since-build="253"/>
    <description><![CDATA[
{{ config.description }}
{{ config.jetbrains_description_suffix }}
    ]]></description>
    <change-notes><![CDATA[
{{ change_notes_html }}
    ]]></change-notes>
    <depends>com.intellij.modules.platform</depends>
    <extensions defaultExtensionNs="com.intellij">
        <themeProvider id="{{ config.id | e }}" path="/themes/celadon.theme.json"/>
        <themeProvider id="{{ config.id | e }}.islands" path="/themes/celadon-islands.theme.json"/>
    </extensions>
</idea-plugin>
